# 이 파일을 .env.local 로 복사한 뒤 값을 채우세요. (.env.local 은 커밋되지 않습니다)

# 1) 서비스 계정 키 파일 경로 — 드라이브/시트 접근용 (기존에 쓰던 그 키)
GOOGLE_APPLICATION_CREDENTIALS=credentials/service-account.json

# 2) 구글 OAuth 클라이언트 (신규 발급 필요, "웹 애플리케이션" 유형)
#    승인된 리디렉션 URI 에 아래를 등록:
#      http://localhost:8080/login/oauth2/code/google
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# 3) 게이트로 쓸 드라이브 폴더 ID
#    폴더를 브라우저에서 열었을 때 .../folders/<이 부분> 이 ID 입니다.
AUTH_DRIVE_FOLDER_ID=

# 4) 세션 쿠키 서명 키 (32바이트 이상) — 아래는 생성된 값이며 그대로 쓰면 됩니다
APP_JWT_SECRET=

# 5) 로컬은 http 이므로 Secure 쿠키를 끕니다 (운영에서는 절대 false 금지)
APP_SECURE_COOKIE=false
